# ========================================
# 重要提示：此文件已废弃
# ========================================
#
# 项目配置已迁移到根目录的 .env 文件
# 请使用项目根目录下的 .env.example 文件
#
# 新的配置文件位置：
#   - 模板文件：<项目根目录>/.env.example
#   - 实际配置：<项目根目录>/.env
#
# 使用说明：
# 1. cd 到项目根目录
# 2. 复制 .env.example 为 .env：cp .env.example .env
# 3. 根据实际情况修改 .env 文件
#
# ========================================
#
# 以下为旧版配置参考（请勿使用）
#
# ========================================

# ========================================
# 数据库配置
# ========================================

# SQLite 数据库文件路径
# 默认：sqlite:///./cdhcprs.db（当前目录下的 cdhcprs.db 文件）
# 生产环境建议使用绝对路径
DATABASE_URL=sqlite:///./cdhcprs.db
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost

# ========================================
# JWT 认证配置
# ========================================

# JWT 密钥（必填）
# 重要：请生成一个随机字符串，不要使用默认值！
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-please-change-in-production

# JWT 加密算法
# 默认：HS256
ALGORITHM=HS256

# JWT Token 过期时间（分钟）
# 默认：30 分钟
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# 应用配置
# ========================================

# 应用名称
# 默认：慢性病诊疗方案推荐系统
APP_NAME=慢性病诊疗方案推荐系统

# 调试模式
# 开发环境：True
# 生产环境：False
DEBUG=True

# ========================================
# 注意事项
# ========================================
#
# 1. SECRET_KEY 必须修改为随机字符串
# 2. 生产环境请将 DEBUG 设置为 False
# 3. LLM 配置可以在管理后台动态修改
# 4. 更多配置项请参考文档
#
# ========================================
